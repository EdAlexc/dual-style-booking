# Public client configuration (no secrets — these values ship in the browser
# bundle). Next.js loads this file automatically for dev and CI builds.

# Clientflow platform (multi-tenant backend). Bookings POST to
# {PLATFORM_API_URL}/api/v1/bookings authenticated by the publishable site
# key — a public, write-only credential issued per site by the platform
# (scripts/provision-tenant.mjs in the platform repo). Set real values in
# .env.local for dev or in the deploy environment.
NEXT_PUBLIC_PLATFORM_API_URL=https://www.ur-space.online
NEXT_PUBLIC_PLATFORM_SITE_KEY=pk_b9ac77911121224d5ee080efca479201ac1a

# The platform Contact form the /contact page submits to (a public form id,
# not a secret — the id also appears in the form's hosted URL).
NEXT_PUBLIC_PLATFORM_CONTACT_FORM_ID=1bbe3bab-ad19-49a0-b38c-b07d8ea32438

# Mux playback IDs for the landing-page hero videos (public IDs, not secrets).
# Leave empty to fall back to /public/videos/{glam,bold}.mp4 / poster images.
NEXT_PUBLIC_MUX_PLAYBACK_ID_GLAM=
NEXT_PUBLIC_MUX_PLAYBACK_ID_BOLD=
