# Copy to .env (or .env.local) and fill in your values.

# Clientflow platform: base URL of the platform deployment and this site's
# publishable (write-only) key, issued by the platform's provision script.
# The booking form POSTs to {URL}/api/v1/bookings with the key; the services
# page reads {URL}/api/v1/services; the contact form POSTs to
# {URL}/api/v1/forms/{NEXT_PUBLIC_PLATFORM_CONTACT_FORM_ID}/submit.
NEXT_PUBLIC_PLATFORM_API_URL=
NEXT_PUBLIC_PLATFORM_SITE_KEY=
NEXT_PUBLIC_PLATFORM_CONTACT_FORM_ID=

# Neon Object Storage credentials for the Work page's image buckets
# (SERVER-ONLY SECRETS — set them in .env.local and in the deploy
# environment, NEVER here and never with a NEXT_PUBLIC prefix). The Work
# page lists both buckets' objects and renders each one as a card, tagged
# by which bucket it came from; builds without these vars fall back to the
# hardcoded pieces in src/lib/site-data.ts. See src/lib/neon-storage.ts and
# the Neon Console's Object Storage tab (project dual-style-booking) for
# the buckets themselves ("work-images-glam" / "work-images-bold", access
# level public_read).
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=
NEON_STORAGE_BUCKET_GLAM=
NEON_STORAGE_BUCKET_BOLD=
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=

# Mux playback IDs for the landing-page hero videos (assets need MP4 support
# enabled). Optional — leave empty to fall back to /public/videos/*.mp4.
NEXT_PUBLIC_MUX_PLAYBACK_ID_GLAM=
NEXT_PUBLIC_MUX_PLAYBACK_ID_BOLD=
